# -*- mode: ruby -*-
# vi: set ft=ruby :
Vagrant.configure("2") do |config|
  config.vm.define "PrestashopRoberto" do |app|
    app.vm.box = "ubuntu/jammy64"
    app.vm.hostname = "prestashop-roberto"
    app.vm.network "private_network", ip: "192.168.57.10"
    app.vm.network "forwarded_port", guest: 80, host: 8081, host_ip: "127.0.0.1", auto_correct: true
    app.vm.network "forwarded_port", guest: 443, host: 8444, host_ip: "127.0.0.1", auto_correct: true
    app.vm.provider "virtualbox" do |vb|
      vb.name = "PrestashopRoberto"
      vb.cpus = 2
      vb.memory = 2048
    end
    app.vm.provision "shell", path: "scripts/install_lamp.sh"
  end
end